{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-local-ai-runtime/job-request.schema.json",
  "title": "Job request",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability", "capability_version", "profile", "input", "policy"],
  "properties": {
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "capability_version": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "enum": ["fast", "balanced", "accurate"]},
    "input": {"type": "object", "additionalProperties": true},
    "output_schema": {"type": ["object", "null"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_classification", "cloud_fallback_allowed", "retention"],
      "properties": {
        "data_classification": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
        "cloud_fallback_allowed": {"type": "boolean", "default": false},
        "allowed_remote_providers": {"type": "array", "items": {"type": "string"}, "default": []},
        "retention": {"type": "string", "enum": ["none", "job_ttl", "consumer_policy"]},
        "human_confirmation_for_remote": {"type": "boolean", "default": true}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 3600000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 65536},
        "priority": {"type": "string", "enum": ["interactive", "normal", "batch"]},
        "allow_degraded_route": {"type": "boolean", "default": false}
      }
    }
  }
}
