{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-local-ai-runtime/job-result.schema.json",
  "title": "Job result",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "status", "result", "evidence", "warnings", "provenance", "timing"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]+$"},
    "status": {"const": "succeeded"},
    "result": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "warnings": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}}}},
    "review_required": {"type": "boolean", "default": false},
    "provenance": {
      "type": "object",
      "required": ["runtime_version", "capability", "route", "engine", "model_artifacts", "preset"],
      "properties": {
        "runtime_version": {"type": "string"},
        "runtime_commit": {"type": "string"},
        "capability": {"type": "string"},
        "route": {"type": "string"},
        "route_revision": {"type": "string"},
        "engine": {"type": "string"},
        "engine_version": {"type": "string"},
        "model_artifacts": {"type": "array", "items": {"type": "string"}},
        "preset": {"type": "string"},
        "transformations": {"type": "array", "items": {"type": "object"}},
        "cache": {"type": "string", "enum": ["miss", "hit", "bypass"]}
      }
    },
    "timing": {
      "type": "object",
      "required": ["queued_ms", "load_ms", "inference_ms", "validation_ms", "total_ms"],
      "properties": {
        "queued_ms": {"type": "integer", "minimum": 0},
        "load_ms": {"type": "integer", "minimum": 0},
        "inference_ms": {"type": "integer", "minimum": 0},
        "validation_ms": {"type": "integer", "minimum": 0},
        "total_ms": {"type": "integer", "minimum": 0}
      }
    },
    "resource_usage": {"type": "object", "additionalProperties": true}
  }
}
