{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-local-ai-runtime/model-manifest.schema.json",
  "title": "Model artefact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "status", "source", "license", "artifacts", "capabilities"],
  "properties": {
    "id": {"type": "string"},
    "family": {"type": "string"},
    "variant": {"type": "string"},
    "status": {"type": "string", "enum": ["discovered", "candidate", "compatible", "benchmarked", "approved", "deprecated", "blocked"]},
    "source": {"type": "object", "required": ["repository", "revision"], "properties": {"repository": {"type": "string"}, "revision": {"type": "string"}, "upstream_model": {"type": "string"}}},
    "license": {"type": "object", "required": ["identifier", "review_status"], "properties": {"identifier": {"type": "string"}, "review_status": {"type": "string", "enum": ["pending", "accepted", "restricted", "blocked"]}, "url": {"type": "string"}}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "filename", "sha256", "format"], "properties": {"role": {"type": "string"}, "filename": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "format": {"type": "string"}, "quantization": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 0}}}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "compatible_engines": {"type": "array", "items": {"type": "object"}},
    "conversion": {"type": ["object", "null"]},
    "benchmark_status": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
